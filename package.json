{
  "name": "reveclicat",
  "version": "0.2.0",
  "description": "Unofficial CLI to simulate RevenueCat subscription lifecycles and test webhooks locally and in CI. Not affiliated with RevenueCat, Inc.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rcc": "dist/cli.js",
    "purr": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scenarios",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "revenuecat",
    "webhooks",
    "cli",
    "subscriptions",
    "testing",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadW2020/ReveCliCat.git"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "express": "5.2.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "homepage": "https://github.com/RadW2020/ReveCliCat#readme",
  "bugs": {
    "url": "https://github.com/RadW2020/ReveCliCat/issues"
  },
  "author": "RadW2020"
}
